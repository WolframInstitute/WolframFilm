Get["/Users/swish/src/wolfram/WolframFilm/data/assets/common.wl"];
tm = TuringMachine[{596440, 2, 3}, {1, {{}, 0}}, 240];
rows = tm[[All, 2]];
heads = tm[[All, 1, 2]] - 1;
states = tm[[All, 1, 1]];
(* rows: fixed-width window *) saveJSON["v7_turing", <|"rows" -> rows, "head" -> heads, "state" -> states, "rule" -> {596440, 2, 3}|>, "RulePlot[TuringMachine[{596440, 2, 3}], {1, {{}, 0}}, 240]", "TuringMachine", "rows = tape colours (0..2) per step, aligned; head = 0-based column; state 1..2"];
Print[Dimensions[rows], " ", MinMax[heads]];
(* Europe borders graph *)
eu = DeleteCases[CountryData["Europe"], Entity["Country", "Svalbard"]];
names = CommonName /@ eu;
pos = Reverse /@ (CountryData[#, "CenterCoordinates"] & /@ eu);
Print[Short[pos, 2]];
borders = EntityValue[eu, "BorderingCountries"];
edges = DeleteDuplicates[Sort /@ Flatten[MapThread[Function[{c, bs}, If[ListQ[bs], UndirectedEdge[c, #] & /@ Intersection[bs, eu], {}]], {eu, borders}]]];
Print[Length[edges]];
coords = AssociationThread[eu, pos];
saveJSON["v8_europe_graph", <|"vertices" -> Table[<|"name" -> CommonName[c], "lon" -> coords[c][[1]], "lat" -> coords[c][[2]]|>, {c, eu}], "edges" -> ({CommonName[#[[1]]], CommonName[#[[2]]]} & /@ edges)|>, "Graph[UndirectedEdge @@@ borders, VertexCoordinates -> positions]", "Graph", "countries of Europe, edges = shared borders"];
gr = Graph[eu, edges, VertexCoordinates -> Thread[eu -> ({#[[1]], 1.45 #[[2]]} & /@ pos)], VertexLabels -> Thread[eu -> (Placed[Style[#, 7], Above] & /@ names)], VertexSize -> 0.5, EdgeStyle -> GrayLevel[0.5]];
save["v8_europe_graph", gr, {520, 420}, "Graph[UndirectedEdge @@@ borders, VertexLabels -> Automatic]", "Graph", "v8-era Graph (8.0 introduced Graph)"];
writeManifest[];
Export["/tmp/claude-501/tm.png", ArrayPlot[rows, ColorRules -> {0 -> White, 1 -> Orange, 2 -> Red}, ImageSize -> 300]];
Export["/tmp/claude-501/rp.png", RulePlot[TuringMachine[{596440, 2, 3}], {1, {{}, 0}}, 60, ImageSize -> 300]];
