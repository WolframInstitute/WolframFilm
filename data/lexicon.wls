ents = WolframLanguageData[];
props = {"Name","FullVersionIntroduced","DateIntroduced","Frequencies","PlaintextUsage","EponymousPeople","FunctionalityAreas","VersionsModified"};
vals = EntityValue[ents, props];
clean[x_Missing] := Null;
clean[d_DateObject] := DateString[d, "ISODate"];
clean[r_Rule] := ToString[r[[1]]] -> clean[r[[2]]];
clean[l_List] := clean /@ l;
clean[e_Entity] := CommonName[e];
clean[x_?NumericQ] := N[x];
clean[s_String] := s;
clean[x_] := ToString[x, InputForm];
rows = Table[AssociationThread[props, clean /@ v], {v, vals}];
rows = Map[If[ListQ[#["Frequencies"]], <|#, "Frequencies" -> Association[#["Frequencies"]]|>, #] &, rows];
Export["lexicon.json", rows, "RawJSON", "Compact" -> True];
Print[Length[rows]];
Print[Counts[Floor[Select[#["FullVersionIntroduced"] & /@ rows, NumberQ]]]];
