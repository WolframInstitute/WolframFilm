p[label_, e_] := Print["### ", label, "\n", ToString[Unevaluated[e], InputForm, PageWidth -> 200], "\n  => ", ToString[e, InputForm, PageWidth -> 200]];
SetAttributes[p, HoldRest];
p["translate", WordTranslation["language", "French"]];
p["plural", Pluralize["mouse"]];
p["unit", UnitConvert[Quantity[5, "Kilometers"], "Miles"]];
p["note", MusicNote["A4", 3/8]];
p["notes", MusicNote /@ {"A4", "C5"}];
p["score", Head[MusicScore[{MusicNote["A4", 1/4], MusicNote["C5", 1/4]}]]];
p["voice", Head[MusicVoice[{MusicNote["A4", 1/4]}]]];
p["wt-version", WolframLanguageData["WordTranslation", "VersionIntroduced"]];
p["strrev", Module[{word = "language"}, StringReverse[word]]];
p["colors", {Red, Green, Blue, Orange, Purple}];
p["chars", Characters["NeXT"]];
p["strlen", StringLength["Mathematica"]];
p["speakver", WolframLanguageData["Speak", "VersionIntroduced"]];
p["freeform-europe-ver", CountryData["Europe"][[;; 8]]];
